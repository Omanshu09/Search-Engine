# Copy this file to .env and fill in real values. Never commit .env.
ENVIRONMENT=development
DEBUG=true

# API
ALLOWED_ORIGINS=["http://localhost:5173"]

# Crawling
CRAWLER_USER_AGENT=ATLASBot/0.1 (+https://example.com/atlas-bot)
CRAWLER_MAX_CONCURRENT_REQUESTS=5
CRAWLER_REQUEST_TIMEOUT_SECONDS=10
CRAWLER_RESPECT_ROBOTS_TXT=true

# Indexing
INDEX_STORAGE_PATH=./data/index

# AI / external services (leave blank to run in extractive/heuristic mode --
# ATLAS works without any of these, just with lower-quality synthesis)
LLM_PROVIDER=              # "anthropic" | "openai" | leave blank
LLM_API_KEY=
LLM_MODEL=                 # optional override; sensible default per provider is used otherwise
EMBEDDING_MODEL_NAME=      # e.g. "openai:text-embedding-3-small"; blank = free local hashing fallback

# Optional external search API (unused; ddgs needs no key for seed URL discovery)
SEARCH_API_KEY=

# Live search / research pipeline
SEED_URLS_PER_QUERY=8
MAX_CRAWL_CONCURRENCY=5
RANKING_SEMANTIC_WEIGHT=0.4
